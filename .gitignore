# Large binaries / installers — never commit (GitHub rejects >100MB)
*.dmg
Claude.dmg

# Machine-local Claude Code settings (personal permission allowlist)
.claude/settings.local.json

# Env files — tokens live here (CIRCLECI_TOKEN, GITHUB_TOKEN, NOTION_TOKEN, …)
.env
.env.*

# Node
node_modules/

# Logs / scratch
*.log

# macOS
.DS_Store

# Compiled EventKit helper — rebuild with ./build-nextmeeting.sh
bin/nextmeeting

# Timestamped backups left by in-place edits (foo.ts.bak.<stamp>). Point-in-time
# copies of files already tracked here.
*.bak
*.bak.*
